package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}
license {
    name: "fontsanitizer_ots_license",
    license_kinds: ["SPDX-license-identifier-BSD-3-Clause"],
    license_text: ["third_party/ots/LICENSE"],
}
cc_library_static {
    name: "libfontsanitizer_ots",
    stl: "libc++_static",
    licenses: ["fontsanitizer_ots_license"],
    srcs: [
        "third_party/ots/src/avar.cc",
        "third_party/ots/src/cff.cc",
        "third_party/ots/src/cff_charstring.cc",
        "third_party/ots/src/cmap.cc",
        "third_party/ots/src/colr.cc",
        "third_party/ots/src/cpal.cc",
        "third_party/ots/src/cvar.cc",
        "third_party/ots/src/cvt.cc",
        "third_party/ots/src/fpgm.cc",
        "third_party/ots/src/fvar.cc",
        "third_party/ots/src/gasp.cc",
        "third_party/ots/src/gdef.cc",
        "third_party/ots/src/glyf.cc",
        "third_party/ots/src/gpos.cc",
        "third_party/ots/src/gsub.cc",
        "third_party/ots/src/gvar.cc",
        "third_party/ots/src/hdmx.cc",
        "third_party/ots/src/head.cc",
        "third_party/ots/src/hhea.cc",
        "third_party/ots/src/hvar.cc",
        "third_party/ots/src/kern.cc",
        "third_party/ots/src/layout.cc",
        "third_party/ots/src/loca.cc",
        "third_party/ots/src/ltsh.cc",
        "third_party/ots/src/math.cc",
        "third_party/ots/src/maxp.cc",
        "third_party/ots/src/metrics.cc",
        "third_party/ots/src/mvar.cc",
        "third_party/ots/src/name.cc",
        "third_party/ots/src/os2.cc",
        "third_party/ots/src/ots.cc",
        "third_party/ots/src/post.cc",
        "third_party/ots/src/prep.cc",
        "third_party/ots/src/stat.cc",
        "third_party/ots/src/variations.cc",
        "third_party/ots/src/vdmx.cc",
        "third_party/ots/src/vhea.cc",
        "third_party/ots/src/vorg.cc",
        "third_party/ots/src/vvar.cc",
    ],
    export_include_dirs: ["third_party/ots/include"],
    local_include_dirs: ["third_party/ots/src"],
    shared_libs: ["libz"],
    cflags: ["-Wno-unused-parameter", "-Wno-sign-compare"],
}
cc_library_shared {
    name: "libfontsanitizer_jni",
    srcs: ["jni/FontSanitizer.cpp", "jni/Sanitize.cpp"],
    static_libs: ["libfontsanitizer_ots"],
    shared_libs: ["libz"],
    header_libs: ["jni_headers"],
    cflags: ["-Wall", "-Werror"],
    stl: "libc++_static",
}
android_app {
    name: "FontSanitizer",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    jni_libs: ["libfontsanitizer_jni"],
    // Load JNI from this APK, including inside an isolated process.
    use_embedded_native_libs: true,
}
